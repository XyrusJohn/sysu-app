rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Read: authenticated users (for admin user management UI).
    // Write: own document only. Role changes MUST go through backend API
    //        (PATCH /api/users/update-role) — not direct Firestore write.
    match /users/{userId} {
      allow get:    if request.auth != null;
      allow list:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Role Requests ───────────────────────────────────────────────────────
    match /role_requests/{requestId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;
    }

    // ─── Queue ───────────────────────────────────────────────────────────────
    // Read: public (Command Center / dashboard need live read).
    // Write: limited to driver's own updates & non-authoritative fields.
    //
    // The authoritative FIFO ordering and dispatch assignment goes through
    // the backend (POST /api/sap/assign). Drivers may update their own active
    // progress (tripStatus, isFull, registrationComplete) on their own queue doc.
    match /queue/{queueId} {
      allow read:  if true;

      // Create: allowed for any authenticated user (QR scan via backend Admin SDK or authenticated client).
      allow create: if request.auth != null;

      // Update: document owner (by driverId or queueId) or admin
      allow update: if request.auth != null
        && (resource.data.driverId == request.auth.uid || request.auth.uid == queueId);

      allow delete: if false;
    }

    // ─── Drivers (Live Fleet Tracking) ───────────────────────────────────────
    // Public read: dashboard map needs live fleet positions.
    // Write: the driver themselves (document ID === auth UID).
    match /drivers/{driverId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // ─── SAP Assignments ──────────────────────────────────────────────────────
    // Public read: anyone can see confirmed assignments (dispatch table).
    // Creation & Deletion: backend API only (POST /api/sap/assign, POST /api/sap/cancel) via Admin SDK.
    // Update: Allowed for the assigned driver to update tripStatus, lineItems (POD), and timestamps.
    match /sap_assignments/{shipmentId} {
      allow read:   if true;
      allow create: if false; // Backend Admin SDK only
      allow delete: if false; // Backend Admin SDK only
      allow update: if request.auth != null
        && (resource.data.driverId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']);
    }

    // ─── Incidents ───────────────────────────────────────────────────────────
    match /incidents/{incidentId} {
      allow read:    if request.auth != null
                     && (resource.data.reporterId == request.auth.uid
                         || !resource.data.keys().hasAll(['reporterId']));
      allow create:  if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reporterId == request.auth.uid;
    }

    // ─── QR Tokens ───────────────────────────────────────────────────────────
    // Public read: TV client displays QR status.
    // Write: backend API only (generateToken/verifyToken/scanToken).
    //        Firebase Admin SDK bypasses rules; direct client writes are blocked.
    match /qr_tokens/{tokenId} {
      allow read:  if true;
      allow write: if false; // Only backend API writes (via Admin SDK)
    }

    // ─── Override Requests (FIFO bypass flow) ───────────────────────────────
    // Dispatchers may create a pending request tied to their own uid. Only the
    // backend can move the request to approved/denied/revoked/consumed — that
    // decision is what issues a single-use override token.
    match /overrideRequests/{requestId} {
      allow read: if request.auth != null;

      // Create only as a pending request authored by the caller.
      allow create: if request.auth != null
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
             'dispatchKey', 'requestedDriverId', 'reason', 'requestedBy',
             'requestedAt', 'status'
           ])
        && request.resource.data.decidedBy == null
        && request.resource.data.decision == null;

      // Status transitions go through the backend; clients can only revoke
      // their own pending requests.
      allow update: if request.auth != null
        && resource.data.requestedBy == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'decidedAt']);

      allow delete: if false;
    }

    // ─── Override Tokens ─────────────────────────────────────────────────────
    // Single-use, short-lived tokens issued by the backend. Clients must not
    // read or write them — the controller verifies and consumes them through
    // Admin SDK.
    match /overrideTokens/{tokenId} {
      allow read, write: if false;
    }

    // ─── Security Guards ───────────────────────────────────────────────────────
    // Read: authenticated users (live onSnapshot in admin Document tab).
    // Write: backend API only (POST/PATCH /api/admin/guards) which uses
    //        Firebase Admin SDK and bypasses rules.
    match /security_guard/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Truck Companies ───────────────────────────────────────────────────────
    // Read: authenticated users (live onSnapshot in admin Document tab).
    // Write: backend API only (POST/PATCH /api/admin/truck-companies).
    match /truck_company/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Default: Deny all ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}