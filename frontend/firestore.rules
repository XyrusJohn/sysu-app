rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Read: authenticated users (for admin user management UI).
    // Write: own document only. Role changes MUST go through backend API
    //        (PATCH /api/users/update-role) — not direct Firestore write.
    match /users/{userId} {
      allow get:    if request.auth != null;
      allow list:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Role Requests ───────────────────────────────────────────────────────
    match /role_requests/{requestId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;
    }

    // ─── Queue ───────────────────────────────────────────────────────────────
    // Read: public (Command Center / dashboard need live read).
    // Write: authenticated users only.
    //
    // SECURITY NOTE: Current queue write rule allows any authenticated user to
    // write any queue document. This is a conscious trade-off: the web dashboard's
    // Fleet Manager assign flow writes directly to Firestore (used by dispatchers
    // with admin credentials to update driver queue entries they don't own).
    //
    // For strict security: restrict to document owner only AND move Fleet Manager
    // assignments through a backend API endpoint that uses Firebase Admin SDK
    // (PATCH /api/dispatch/assign — see integration guide).
    //
    // Queue entries created by QR scan have an auto-generated doc ID (not the
    // driver's UID). The authoritative ownership field is `driverId` in the
    // document data (not the document ID).
    match /queue/{queueId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ─── Drivers (Live Fleet Tracking) ───────────────────────────────────────
    // Public read: dashboard map needs live fleet positions.
    // Write: the driver themselves (document ID === auth UID).
    match /drivers/{driverId} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // ─── SAP Assignments ──────────────────────────────────────────────────────
    // Public read: anyone can see confirmed assignments (dispatch table).
    // Write: authenticated users (admin UI is the write gate).
    //        Strictly: writes should go through backend API (PATCH /api/dispatch/assign)
    //        which uses Firebase Admin SDK and bypasses rules.
    match /sap_assignments/{shipmentId} {
      allow read:  if true;
      allow write: if request.auth != null;

      // Validate new lineItems schema on create.
      // - customerName required (string): delivery recipient / ship-to party
      // - quantity required (number): float/double, e.g. 2.5, 3.25
      // - obdNumber required (string): SAP OBD/Delivery number
      // - amount is explicitly forbidden inside each line item
      allow create: if request.auth != null
        && request.resource.data.lineItems.size() > 0
        && request.resource.data.lineItems[0].obdNumber is string
        && request.resource.data.lineItems[0].quantity is number
        && request.resource.data.lineItems[0].customerName is string
        && !("amount" in request.resource.data.lineItems[0]);
    }

    // ─── Incidents ───────────────────────────────────────────────────────────
    match /incidents/{incidentId} {
      allow read:    if request.auth != null
                     && (resource.data.reporterId == request.auth.uid
                         || !resource.data.keys().hasAll(['reporterId']));
      allow create:  if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reporterId == request.auth.uid;
    }

    // ─── QR Tokens ───────────────────────────────────────────────────────────
    // Public read: TV client displays QR status.
    // Write: backend API only (generateToken/verifyToken/scanToken).
    //        Firebase Admin SDK bypasses rules; direct client writes are blocked.
    match /qr_tokens/{tokenId} {
      allow read:  if true;
      allow write: if false; // Only backend API writes (via Admin SDK)
    }

    // ─── Default: Deny all ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}