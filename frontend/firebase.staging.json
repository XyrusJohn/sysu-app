{
  "hosting": [
    {
      "target": "staging",
      "public": "dist",
      "predeploy": ["npm run build -- --mode staging --env-file .env.staging"],
      "ignore": ["firebase.json", "firebase.staging.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Pragma", "value": "no-cache" },
            { "key": "Expires", "value": "0" }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.@(js|css|woff|woff2|ttf|otf|eot)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/qr-generator", "destination": "/qr-generator.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}
