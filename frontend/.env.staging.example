# Copy to .env.staging and fill in the public Firebase Web App config and staging endpoints.
VITE_RELEASE_TARGET=staging
VITE_FIREBASE_API_KEY=replace-with-sysu-stage-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=sysu-stage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sysu-stage
VITE_FIREBASE_STORAGE_BUCKET=sysu-stage.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sysu-stage-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-sysu-stage-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-sysu-stage-measurement-id
VITE_API_URL=https://replace-with-staging-sysu-app-api.onrender.com
VITE_SOCKET_URL=https://replace-with-staging-sysu-app-api.onrender.com
VITE_DRIVER_TRACKING_URL=https://replace-with-staging-sysu-go-api.onrender.com
