{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 60,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE"
  }
}
