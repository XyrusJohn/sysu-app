# Local isolated Firestore development. Configure Firebase Auth emulator separately
# for real login; HTTP/socket auth tests use synthetic fixtures.
PORT=8080
NODE_ENV=development
TRUST_PROXY=0
FIREBASE_PROJECT_ID=demo-sysu-security
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
SAP_URL=http://127.0.0.1:8090/synthetic-sap
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_MAX=300
READINESS_TIMEOUT_MS=3000
RELEASE_VERSION=local

# Staging/production: explicitly set project and matching credentials or ADC;
# unset FIRESTORE_EMULATOR_HOST, set NODE_ENV=production and exact HTTPS origins.
# FIREBASE_SERVICE_ACCOUNT_JSON must be injected securely, never committed.
# TRUST_PROXY: verified proxy hop count (0-16) or explicit IP/CIDR; no 'true'.
# Limits above are provisional single-replica defaults pending measured traffic.
