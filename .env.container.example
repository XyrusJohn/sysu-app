# Copy this file to .env and replace deployment-specific values.
NODE_ENV=production
PORT=8080
HOST_PORT=8080
TRUST_PROXY=0
FIREBASE_PROJECT_ID=your-firebase-project-id
ALLOWED_ORIGINS=https://your-dashboard.example.com
SAP_URL=https://your-sap-host.example.com/odata/path
# Supply FIREBASE_SERVICE_ACCOUNT_JSON through a secret manager when ADC is unavailable.
# Never commit a real service account or private key.
